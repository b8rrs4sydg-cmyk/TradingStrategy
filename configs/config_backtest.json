  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "fee": 0.001,
  "dataformat_ohlcv": "feather",
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "change-me-to-a-random-32+char-jwt-secret",
    "ws_token": "change-me-ws-token",
    "CORS_origins": [],
    "username": "freqtrader",
    "password": "change-me"
  },
  "bot_name": "RotationPullback",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}