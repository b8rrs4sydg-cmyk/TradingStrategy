# === Postgres ===
POSTGRES_USER=flight
POSTGRES_PASSWORD=flight
POSTGRES_DB=flight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === Backend ===
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+psycopg://flight:flight@postgres:5432/flight
APP_CORS_ORIGINS=http://localhost:3000

# === Flight data providers (Phase 2+) ===
# Priority at runtime: Amadeus (if both creds) → Skyscanner (if key) → Stub.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
SKYSCANNER_RAPIDAPI_KEY=
SKYSCANNER_RAPIDAPI_HOST=skyscanner80.p.rapidapi.com

# === Rate limit on POST /search ===
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_S=60

# === Admin endpoints (/admin/*) ===
# Leave blank in dev. Setting any value enables POST /admin/seed behind
# "Authorization: Bearer <this value>". Rotate for every deploy.
APP_ADMIN_TOKEN=

# === Observability ===
# Set to 1 to emit single-line JSON logs (Render / Cloud Logging friendly).
APP_LOG_JSON=0

# === Frontend ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
