# === Postgres ===
POSTGRES_USER=flight
POSTGRES_PASSWORD=flight
POSTGRES_DB=flight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === Backend ===
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+psycopg://flight:flight@postgres:5432/flight
APP_CORS_ORIGINS=http://localhost:3000

# === Flight data providers (Phase 2+) ===
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
SKYSCANNER_RAPIDAPI_KEY=

# === Frontend ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
